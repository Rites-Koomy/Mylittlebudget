{
  "name": "budget-perso",
  "private": true,
  "version": "0.1.0",
  "description": "Squelette local de Budget Perso",
  "workspaces": ["apps/web", "worker"],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "typecheck": "npm run typecheck --workspace apps/web && npm run typecheck --workspace worker",
    "test": "npm run test --workspace worker"
  },
  "engines": { "node": ">=20" }
}
